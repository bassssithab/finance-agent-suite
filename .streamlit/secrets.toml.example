# Copy this file to `.streamlit/secrets.toml` and fill in a real key.
# `.streamlit/secrets.toml` is gitignored — never commit the real key.
#
# The VAT Treatment Agent in app.py reads this via st.secrets["ANTHROPIC_API_KEY"].
# The Reconciliation Agent needs no key.
#
# When deployed (e.g. Streamlit Community Cloud), set this in the app's
# Settings -> Secrets instead of shipping a file.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"
